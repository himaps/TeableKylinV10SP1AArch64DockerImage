# ===== Teable 离线部署配置(install.sh 首次运行会复制为 .env) =====
# 密码请改成字母数字组合(勿用 $ 等特殊字符，compose 会做变量替换)

# 部署版本(与镜像包一致，勿改)
TEABLE_VERSION=1.10.0
# 对外服务端口
APP_PORT=3000
TIMEZONE=Asia/Shanghai

# ===== Postgres =====
POSTGRES_HOST=teable-db
POSTGRES_PORT=5432
POSTGRES_DB=teable
POSTGRES_USER=teable
POSTGRES_PASSWORD=CHANGE_ME_pg_password

# ===== Redis =====
REDIS_HOST=teable-cache
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_redis_password

# ===== 应用 =====
# 部署后如需让局域网其他机器访问，改成本机内网 IP，例如 http://192.168.1.10:3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
PRISMA_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# 桌面客户端直连数据库用(与 compose 中 postgres 的 42345 端口映射对应)
PUBLIC_DATABASE_PROXY=127.0.0.1:42345

BACKEND_CACHE_PROVIDER=redis
BACKEND_CACHE_REDIS_URI=redis://default:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ===== 邮件(可选，需要发邮件功能时取消注释并修改) =====
#BACKEND_MAIL_HOST=smtp.example.com
#BACKEND_MAIL_PORT=465
#BACKEND_MAIL_SECURE=true
#BACKEND_MAIL_SENDER=noreply@example.com
#BACKEND_MAIL_SENDER_NAME=Teable
#BACKEND_MAIL_AUTH_USER=username
#BACKEND_MAIL_AUTH_PASS=password
