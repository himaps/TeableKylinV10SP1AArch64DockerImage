# ==== ONLYOFFICE 协同编辑离线部署配置 ====
# install.sh 首次运行会自动: 复制本文件为 .env、自动探测 SERVER_IP、
# 为所有 CHANGE_ME 项生成随机密码(纯字母数字)。也可先手动改好再安装。

# ---- 入口 ----
# 本机内网 IP(浏览器与协同 websocket 都走它)。换 IP 后改这里再重跑 bash install.sh
SERVER_IP=CHANGE_ME
# 对外端口，默认 80；改端口后访问地址为 http://IP:端口
APP_PORT=80

# ---- 版本(必须与随包 images/ 内镜像一致，见 MANIFEST.txt，勿随意修改) ----
DS_VERSION=8.3.3
NC_VERSION=30.0.12

# ---- 管理员(nextcloud 首次启动自动创建，登录后请自行改密) ----
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME

# ---- 数据库/缓存/密钥(纯字母数字，勿含特殊字符) ----
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# 协同编辑 JWT 密钥(documentserver 与 nextcloud 连接器共用)
JWT_SECRET=CHANGE_ME

TIMEZONE=Asia/Shanghai
